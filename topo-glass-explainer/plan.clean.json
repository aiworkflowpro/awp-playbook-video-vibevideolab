  "narration": {
    "words": "data/buyer/words.json",
    "sentences": [
      {
        "id": "n01",
        "text": "Most people use AI the way they would use a very smart reference book.",
        "s": 0,
        "e": 4.41
      },
      {
        "id": "n02",
        "text": "You ask it a question and you get a good answer back in a few seconds.",
        "s": 5.17,
        "e": 9.02
      },
      {
        "id": "n03",
        "text": "An AI agent is built on a different idea, and that idea is worth understanding properly.",
        "s": 10,
        "e": 16.43
      },
      {
        "id": "n04",
        "text": "You do not ask an agent for an answer, you hand it a whole job to finish.",
        "s": 17.77,
        "e": 23.07
      },
      {
        "id": "n05",
        "text": "It works out the steps by itself and keeps going until the job is actually done.",
        "s": 23.91,
        "e": 29.03
      },
      {
        "id": "n06",
        "text": "That sounds like magic until you see how simple the machinery underneath really is.",
        "s": 29.95,
        "e": 35.49
      },
      {
        "id": "n07",
        "text": "By the end you will know which jobs to hand over and which ones to keep for yourself.",
        "s": 36.3,
        "e": 41.51
      },
      {
        "id": "n08",
        "text": "This is how AI agents actually work.",
        "s": 43.59,
        "e": 46.6
      }
    ]
  },
